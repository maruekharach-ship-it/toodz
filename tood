local SmoothBox = createTextBox("กรอกความหน่วง Smoothness (0.01 - 1.0)", Container)

local aimbotActive, silentAimActive, wallcheckActive, teamcheckActive = false, false, false, false
local fovSize, smoothness = 150, 0.2

AimbotToggle.MouseButton1Click:Connect(function()
    aimbotActive = not aimbotActive
